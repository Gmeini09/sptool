# SP Tool license server – copy to server/.env (or set in your host) and fill in.
NODE_ENV=production
PORT=8787
# Public HTTPS address of this server (used for the Discord redirect)
PUBLIC_URL=https://license.example.com
# Discord application (https://discord.com/developers/applications → OAuth2)
# Redirect URL to add there: <PUBLIC_URL>/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Extra admins (comma separated). The owner 697402284849627180 is always admin.
ADMIN_DISCORD_IDS=
# Long random string; makes stored HWID hashes useless outside this server
HWID_SERVER_SALT=
DB_PATH=server/data/sptool.db
LICENSE_PRIVATE_KEY_FILE=server/data/license-ed25519.pem
SESSION_DAYS=30
OFFLINE_GRACE_HOURS=72
DEFAULT_MAX_DEVICES=1
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
CORS_ORIGINS=*
